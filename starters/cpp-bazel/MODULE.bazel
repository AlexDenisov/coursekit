module(name = "course")  # rename to your course

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "toolchains_llvm", version = "1.12.0")

# Hermetic clang from https://github.com/mull-project/toolchains (LLVM 23.1.3).
# The archive has no libc++; on macOS toolchains_llvm uses the SDK's libc++.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    cxx_standard = {"": "c++20"},
    llvm_version = "23.1.3",
    sha256 = {
        "darwin-aarch64": "33681225d9d97b39cec219d7ec682cf9d23d150fdb44e313b33cce24ea91d532",
    },
    strip_prefix = {
        "darwin-aarch64": "Darwin-aarch64.toolchain",
    },
    urls = {
        "darwin-aarch64": ["https://github.com/mull-project/toolchains/releases/download/39167916899/Darwin-aarch64.toolchain.tar.xz"],
    },
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# compile_commands.json for clangd: `bazel run :refresh_compile_commands`
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    # Upstream predates Bazel 9, which dropped native py_binary.
    patch_strip = 1,
    patches = ["//third_party:hedron_compile_commands_bazel9.patch"],
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)
