load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "event_loop",
    srcs = ["event_loop.cc"],
    hdrs = ["event_loop.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//common:check",
        "//common:clock",
        "//net/nonblocking",
        "//net/sockets",
