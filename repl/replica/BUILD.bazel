load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "replica",
    srcs = ["replica.cc"],
    hdrs = ["replica.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//cmd/dispatch",
        "//db/keyspace",
        "//net/buffers",
        "//net/event_loop",
        "//net/nonblocking",
        "//net/sockets",
        "//persist/rdb_reader",
        "//resp/encoder",
        "//resp/parser",
    ],
)

cc_test(
    name = "replica_test",
    size = "small",
    srcs = ["replica_test.cc"],
    data = ["//persist/rdb_reader:testdata/redis8_plain.rdb"],
    deps = [
        ":replica",
        "//common:test_client",
        "//db/lists",
        "@googletest//:gtest_main",
    ],
)

# Follows a real redis-server primary. Skips if redis-server isn't installed.
#   bazel test //repl/replica:real_primary_test --test_output=all
cc_test(
    name = "real_primary_test",
    size = "small",
    srcs = ["real_primary_test.cc"],
    tags = ["manual"],
    deps = [
        ":replica",
        "//common:test_client",
        "//db/lists",
        "@googletest//:gtest_main",
    ],
)
